# Copy to .env (gitignored). Values come from the Meta app dashboard:
# Instagram > API setup with Instagram business login. Use the INSTAGRAM app ID/secret shown there,
# not the Meta app ID at the top of the dashboard.
IG_APP_ID=
IG_APP_SECRET=
IG_ACCESS_TOKEN=
IG_USER_ID=
# Only for `python -m bot auth url/exchange`; must match a redirect URI saved in the dashboard
IG_REDIRECT_URI=https://ryanhermes.com/
